#!/system/bin/sh

set -u

MODDIR=${0%/*}
MODDIR=${MODDIR%/*}
STATE_DIR=/data/adb/dockroot
RUNTIME_DIR="$STATE_DIR/bin"
LOG_DIR="$STATE_DIR/logs"
HEALTH_STATE_DIR="$STATE_DIR/health"
LOCK_DIR="$STATE_DIR/locks"
PROC_ROOT=${PROC_ROOT:-/proc}
POWER_ROOT=${POWER_ROOT:-/sys/power}
WAKELOCK_TAG=dockroot_keep_awake
SCHEDULED_WAKELOCK_TAG=dockroot_scheduled_wake
WAKEALARM_PID_FILE="$STATE_DIR/wakealarm.pid"
WAKEALARM_STATUS_FILE="$STATE_DIR/wakealarm.status"
CONFIG_FILE="$STATE_DIR/config.env"
AUTOSTART_FILE="$STATE_DIR/autostart.list"
STACK_DIR="$STATE_DIR/stacks"
VOLUME_DIR="$STATE_DIR/volumes"
DNS_ETC_DIR="$STATE_DIR/dns-etc"
DOCKROOT="$RUNTIME_DIR/DockRoot"
RURI="$RUNTIME_DIR/ruri"
DOCKROOT_URL=https://fw.koolcenter.com/binary/DockRoot/DockRoot.arm64
RURI_URL=https://fw.koolcenter.com/binary/DockRoot/ruri.arm64
DOCKROOT_SHA256=42b23398d9cf8838ca55084becb1aaee438e91e38d7f1696346663efbe0a9e14
RURI_SHA256=fab3929b1c34a7d066454617712b93aa2f1e8321cde0c155b5080008f19dbcf7

msg() { printf '[DockRoot 模块] %s\n' "$*"; }
err() { printf '[DockRoot 模块] 错误：%s\n' "$*" >&2; }

ensure_state() {
  mkdir -p "$RUNTIME_DIR" "$STATE_DIR/data" "$LOG_DIR" "$HEALTH_STATE_DIR" "$LOCK_DIR" "$STACK_DIR" "$VOLUME_DIR" 2>/dev/null || return 1
  [ -f "$CONFIG_FILE" ] || cp "$MODDIR/config.env" "$CONFIG_FILE"
  [ -f "$AUTOSTART_FILE" ] || : > "$AUTOSTART_FILE"
  chmod 0700 "$STATE_DIR" "$RUNTIME_DIR" "$STATE_DIR/data" "$LOG_DIR" "$HEALTH_STATE_DIR" "$LOCK_DIR" "$STACK_DIR" 2>/dev/null || true
  chmod 0755 "$VOLUME_DIR" 2>/dev/null || true
  chmod 0600 "$CONFIG_FILE" "$AUTOSTART_FILE" 2>/dev/null || true
}

load_config() {
  AUTO_START=1
  BOOT_WAIT=120
  DATA_ROOT="$STATE_DIR/data"
  DNS_SERVERS='223.5.5.5 1.1.1.1'
  STOP_TIMEOUT=15
  START_TIMEOUT=30
  MAX_LOG_SIZE_KB=1024
  HEALTHCHECK_ENABLE=1
  HEALTHCHECK_INTERVAL=300
  HEALTHCHECK_FAILURES=3
  HEALTHCHECK_COOLDOWN=1800
  KEEP_AWAKE=0
  SCHEDULED_WAKE=0
  WAKE_TIMES=09:57,17:57
  WAKE_HOLD_SECONDS=300
  WAKE_TIMEZONE=Asia/Shanghai
  if [ -r "$CONFIG_FILE" ]; then
    # 仅接受已知键，避免直接执行配置文件内容。
    while IFS='=' read -r key value; do
      case "$key" in
        AUTO_START) case "$value" in 0|1) AUTO_START=$value;; esac ;;
        BOOT_WAIT) case "$value" in ''|*[!0-9]*) ;; *) BOOT_WAIT=$value;; esac ;;
        DATA_ROOT) case "$value" in /*) DATA_ROOT=$value;; esac ;;
        DNS_SERVERS) DNS_SERVERS=$value ;;
        STOP_TIMEOUT) case "$value" in ''|*[!0-9]*) ;; *) STOP_TIMEOUT=$value;; esac ;;
        START_TIMEOUT) case "$value" in ''|*[!0-9]*) ;; *) START_TIMEOUT=$value;; esac ;;
        MAX_LOG_SIZE_KB) case "$value" in ''|*[!0-9]*) ;; *) MAX_LOG_SIZE_KB=$value;; esac ;;
        HEALTHCHECK_ENABLE) case "$value" in 0|1) HEALTHCHECK_ENABLE=$value;; esac ;;
        HEALTHCHECK_INTERVAL) case "$value" in ''|*[!0-9]*) ;; *) HEALTHCHECK_INTERVAL=$value;; esac ;;
        HEALTHCHECK_FAILURES) case "$value" in ''|*[!0-9]*) ;; *) HEALTHCHECK_FAILURES=$value;; esac ;;
        HEALTHCHECK_COOLDOWN) case "$value" in ''|*[!0-9]*) ;; *) HEALTHCHECK_COOLDOWN=$value;; esac ;;
        KEEP_AWAKE) case "$value" in 0|1) KEEP_AWAKE=$value;; esac ;;
        SCHEDULED_WAKE) case "$value" in 0|1) SCHEDULED_WAKE=$value;; esac ;;
        WAKE_TIMES) case "$value" in ''|*[!0-9,:]*) ;; *) WAKE_TIMES=$value;; esac ;;
        WAKE_HOLD_SECONDS) case "$value" in ''|*[!0-9]*) ;; *) WAKE_HOLD_SECONDS=$value;; esac ;;
        WAKE_TIMEZONE) case "$value" in ''|*[!A-Za-z0-9_+/-]*) ;; *) WAKE_TIMEZONE=$value;; esac ;;
      esac
    done < "$CONFIG_FILE"
  fi
}

have_cmd() { command -v "$1" >/dev/null 2>&1; }

sha256_file() {
  if have_cmd sha256sum; then
    sha256sum "$1" | awk '{print $1}'
  elif have_cmd toybox; then
    toybox sha256sum "$1" | awk '{print $1}'
  else
    return 1
  fi
}

download() {
  url=$1
  output=$2
  if have_cmd curl; then
    curl -fL --connect-timeout 15 --retry 2 -o "$output" "$url"
  elif have_cmd wget; then
    wget -O "$output" "$url"
  elif have_cmd busybox; then
    busybox wget -O "$output" "$url"
  else
    err '找不到 curl、wget 或 busybox wget'
    return 1
  fi
}

install_one() {
  name=$1
  url=$2
  expected=$3
  target=$4
  temp="$target.download.$$"
  rm -f "$temp"
  msg "正在下载 $name"
  if ! download "$url" "$temp"; then
    rm -f "$temp"
    return 1
  fi
  actual="$(sha256_file "$temp")" || {
    rm -f "$temp"
    err '设备缺少 SHA-256 校验工具'
    return 1
  }
  if [ "$actual" != "$expected" ]; then
    rm -f "$temp"
    err "$name 校验失败；上游文件可能已更新，模块不会运行未知文件"
    return 1
  fi
  chmod 0755 "$temp" && mv -f "$temp" "$target"
}

runtime_ready() {
  [ -x "$DOCKROOT" ] && [ -x "$RURI" ]
}

prepare_dns_environment() {
  load_config
  mkdir -p "$DNS_ETC_DIR" || return 1
  : > "$DNS_ETC_DIR/resolv.conf" || return 1
  for server in $DNS_SERVERS; do
    case "$server" in
      *[!0-9a-fA-F.:]*) continue ;;
    esac
    printf 'nameserver %s\n' "$server" >> "$DNS_ETC_DIR/resolv.conf"
  done
  [ -s "$DNS_ETC_DIR/resolv.conf" ] || {
    err 'DNS_SERVERS 中没有有效地址'
    return 1
  }
  chmod 0755 "$DNS_ETC_DIR"
  chmod 0644 "$DNS_ETC_DIR/resolv.conf"

  if [ -d /apex/com.android.conscrypt/cacerts ]; then
    DOCKROOT_CERT_DIR=/apex/com.android.conscrypt/cacerts
  elif [ -d /system/etc/security/cacerts ]; then
    cert_copy="$STATE_DIR/cacerts"
    if [ ! -d "$cert_copy" ]; then
      mkdir -p "$cert_copy" || return 1
      cp -a /system/etc/security/cacerts/. "$cert_copy/" || return 1
    fi
    DOCKROOT_CERT_DIR=$cert_copy
  else
    DOCKROOT_CERT_DIR=
  fi
}

run_dockroot() {
  prepare_dns_environment || return 1
  if [ ! -x /system/bin/unshare ]; then
    err '设备缺少 /system/bin/unshare，无法为 DockRoot 建立独立 DNS 环境'
    return 1
  fi
  DR_DNS_ETC="$DNS_ETC_DIR" \
  DR_CERT_DIR="$DOCKROOT_CERT_DIR" \
    /system/bin/unshare -m "$MODDIR/bin/dockroot-exec" "$DOCKROOT" "$@"
}

install_runtime() {
  ensure_state || return 1
  install_one DockRoot "$DOCKROOT_URL" "$DOCKROOT_SHA256" "$DOCKROOT" || return 1
  install_one ruri "$RURI_URL" "$RURI_SHA256" "$RURI" || return 1
  msg '运行环境安装完成'
  "$RURI" -v 2>&1 | head -n 1 || true
}

sync_dockroot_config() {
  load_config
  case "$DATA_ROOT" in
    /|/data|/data/adb|/system|/vendor|/product|/storage|/sdcard|/mnt)
      err "DATA_ROOT 不能指向系统级目录：$DATA_ROOT"
      return 1
      ;;
  esac
  mkdir -p "$DATA_ROOT" || return 1
  : > "$DATA_ROOT/.dockroot-managed" || return 1
  config="$RUNTIME_DIR/dockroot.json"
  temp="$config.tmp.$$"
  escaped="$(printf '%s' "$DATA_ROOT" | sed 's/[\\"]/\\&/g')"
  printf '{\n  "registry-mirrors": [],\n  "data-root": "%s",\n  "useKspeeder": false\n}\n' "$escaped" > "$temp" || return 1
  if [ ! -f "$config" ] || ! cmp -s "$temp" "$config" 2>/dev/null; then
    mv -f "$temp" "$config"
  else
    rm -f "$temp"
  fi
  chmod 0600 "$config"
}

require_runtime() {
  if ! runtime_ready; then
    msg '首次使用，正在自动安装运行环境'
    install_runtime || return 1
  fi
  sync_dockroot_config
}

valid_name() {
  case "$1" in
    ''|*[!a-zA-Z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

normalize_image() {
  image=$1
  case "$image" in
    docker://*) image=${image#docker://} ;;
  esac
  case "$image" in
    *:*) ;;
    *) image="$image:latest" ;;
  esac
  case "$image" in
    */*)
      registry=${image%%/*}
      case "$registry" in
        *.*|localhost|*:* ) printf '%s\n' "$image" ;;
        *) printf 'docker.io/%s\n' "$image" ;;
      esac
      ;;
    *) printf 'docker.io/library/%s\n' "$image" ;;
  esac
}

cleanup_incomplete_destination() {
  name=$1
  destination="$DATA_ROOT/$name"
  if [ -d "$destination" ] && [ ! -d "$destination/rootfs" ]; then
    msg "正在清理上次拉取失败留下的不完整目录：$name"
    rm -rf "$destination"
  fi
}

stack_file() {
  printf '%s/%s.conf\n' "$STACK_DIR" "$1"
}

stack_values() {
  name=$1
  wanted=$2
  file="$(stack_file "$name")"
  [ -r "$file" ] || return 1
  awk -F= -v wanted="$wanted" '
    $1 == wanted { print substr($0, length($1) + 2) }
  ' "$file"
}

stack_env_value() {
  name=$1
  wanted=$2
  stack_values "$name" ENV | awk -F= -v wanted="$wanted" '
    $1 == wanted { print substr($0, length($1) + 2); exit }
  '
}

append_stack_line() {
  file=$1
  line=$2
  grep -Fx "$line" "$file" >/dev/null 2>&1 || printf '%s\n' "$line" >> "$file"
}

migrate_stack() {
  name=$1
  file="$(stack_file "$name")"
  case "$name" in
    openlist)
      append_stack_line "$file" 'CHECK_PORT=5244'
      append_stack_line "$file" 'HEALTH_URL=http://127.0.0.1:5244/'
      ;;
    qinglong)
      ql_port="$(stack_env_value "$name" QlPort)"
      ql_grpc_port="$(stack_env_value "$name" QlGrpcPort)"
      ql_port=${ql_port:-5700}
      if [ -z "$ql_grpc_port" ]; then
        ql_grpc_port=5501
        append_stack_line "$file" "ENV=QlGrpcPort=$ql_grpc_port"
      fi
      temp="$file.tmp.$$"
      sed '/^CHECK_PORT=/d; /^HEALTH_URL=/d' "$file" > "$temp" || return 1
      mv -f "$temp" "$file"
      chmod 0600 "$file"
      append_stack_line "$file" "CHECK_PORT=$ql_port"
      append_stack_line "$file" "CHECK_PORT=$ql_grpc_port"
      append_stack_line "$file" "HEALTH_URL=http://127.0.0.1:$ql_port/api/health"
      ;;
  esac
}

apply_stack() {
  name=${1:-}
  valid_name "$name" || { err '请提供有效配置名'; return 1; }
  ensure_state || return 1
  load_config
  file="$(stack_file "$name")"
  [ -r "$file" ] || { err "配置不存在：$file"; return 1; }
  migrate_stack "$name"

  stack_image=
  stack_autostart=0
  stack_command=
  stack_apply_command=
  stack_arg_seen=0
  stack_apply_arg_seen=0
  set -- run --renew
  while IFS='=' read -r key value; do
    key="$(printf '%s' "$key" | tr -d '\r')"
    value="$(printf '%s' "$value" | tr -d '\r')"
    case "$key" in
      ''|'#'*) continue ;;
      IMAGE) stack_image=$value ;;
      AUTOSTART)
        case "$value" in 0|1) stack_autostart=$value ;; *) err 'AUTOSTART 只能是 0 或 1'; return 1 ;; esac
        ;;
      VOLUME)
        case "$value" in *[[:space:]]*) err "VOLUME 暂不支持包含空格的路径：$value"; return 1 ;; esac
        source_path=${value%%:*}
        remainder=${value#*:}
        target_path=${remainder%%:*}
        case "$remainder" in
          *:ro) volume_mode=ro ;;
          *:*) err "VOLUME 只支持可选的 :ro 模式：$value"; return 1 ;;
          *) volume_mode=rw ;;
        esac
        case "$source_path" in /*) ;; *) err "卷来源必须是绝对路径：$value"; return 1 ;; esac
        case "$target_path" in /*) ;; *) err "卷目标必须是绝对路径：$value"; return 1 ;; esac
        # 已存在的普通文件可直接作为 bind mount；不存在时仍按目录创建，
        # 避免把常见的数据目录误判成文件。
        if [ ! -e "$source_path" ]; then
          mkdir -p "$source_path" || return 1
        fi
        # 部分镜像（如 OpenList 4.1+）会在容器内切换到非 root UID。
        # 上级 /data/adb/dockroot 仍为 0700，放宽挂载点本身不会暴露给普通 Android 应用。
        if [ -f "$source_path" ]; then
          if [ "$volume_mode" = ro ]; then
            chmod 0644 "$source_path" 2>/dev/null || true
          else
            chmod 0666 "$source_path" 2>/dev/null || true
          fi
        elif [ "$volume_mode" = ro ]; then
          chmod 0755 "$source_path" 2>/dev/null || true
        else
          chmod 0777 "$source_path" 2>/dev/null || true
        fi
        set -- "$@" -v "$value"
        ;;
      ENV)
        case "$value" in *=*) set -- "$@" -e "$value" ;; *) err "环境变量格式应为 KEY=VALUE：$value"; return 1 ;; esac
        ;;
      HOSTNAME) [ -n "$value" ] && set -- "$@" --hostname "$value" ;;
      WORKDIR) case "$value" in /*) set -- "$@" -w "$value" ;; *) err 'WORKDIR 必须是绝对路径'; return 1 ;; esac ;;
      COMMAND)
        [ -z "$stack_command" ] || { err 'COMMAND 只能填写一次'; return 1; }
        case "$value" in /*) stack_command=$value ;; *) err 'COMMAND 必须是容器内绝对路径'; return 1 ;; esac
        ;;
      ARG)
        [ -n "$value" ] || { err 'ARG 不能为空'; return 1; }
        stack_arg_seen=1
        ;;
      APPLY_COMMAND)
        [ -z "$stack_apply_command" ] || { err 'APPLY_COMMAND 只能填写一次'; return 1; }
        case "$value" in /*) stack_apply_command=$value ;; *) err 'APPLY_COMMAND 必须是容器内绝对路径'; return 1 ;; esac
        ;;
      APPLY_ARG)
        [ -n "$value" ] || { err 'APPLY_ARG 不能为空'; return 1; }
        stack_apply_arg_seen=1
        ;;
      REQUIRED_FILE)
        case "$value" in /*) ;; *) err 'REQUIRED_FILE 必须是宿主机绝对路径'; return 1 ;; esac
        ;;
      CHECK_PORT)
        case "$value" in ''|*[!0-9]*) err "CHECK_PORT 必须是数字：$value"; return 1 ;; esac
        if [ "$value" -lt 1 ] || [ "$value" -gt 65535 ]; then
          err "CHECK_PORT 必须在 1-65535 之间：$value"
          return 1
        fi
        ;;
      HEALTH_URL|READY_URL)
        case "$value" in
          http://127.0.0.1:*|http://localhost:*) ;;
          *) err "$key 仅允许本机 HTTP 地址：$value"; return 1 ;;
        esac
        ;;
      *) err "不支持的配置项：$key"; return 1 ;;
    esac
  done < "$file"

  [ -n "$stack_image" ] || { err "配置缺少 IMAGE：$file"; return 1; }
  if [ "$stack_arg_seen" = 1 ] && [ -z "$stack_command" ]; then
    err '配置含有 ARG，但缺少 COMMAND'
    return 1
  fi
  if [ "$stack_apply_arg_seen" = 1 ] && [ -z "$stack_apply_command" ]; then
    err '配置含有 APPLY_ARG，但缺少 APPLY_COMMAND'
    return 1
  fi
  if [ "$name" = openlist ] && [ "$stack_image" = openlistteam/openlist:latest-aio ]; then
    stack_image=openlistteam/openlist:latest
    sed -i 's|^IMAGE=openlistteam/openlist:latest-aio$|IMAGE=openlistteam/openlist:latest|' "$file"
    msg '已将旧版 OpenList AIO 模板迁移为实际可准确拉取的标准完整版 latest'
  fi
  if [ ! -d "$DATA_ROOT/$name/rootfs" ]; then
    pull_image "$stack_image" "$name" || return 1
  fi

  # 仅更新 ruri.conf；执行一次性命令，避免 apply 启动长期服务。
  # -- 用于隔开 DockRoot 参数，防止容器命令中的 -c/--metrics 等被 Cobra 误解析。
  set -- "$@" "$name" --
  if [ -n "$stack_apply_command" ]; then
    set -- "$@" "$stack_apply_command"
    while IFS='=' read -r key value; do
      key="$(printf '%s' "$key" | tr -d '\r')"
      value="$(printf '%s' "$value" | tr -d '\r')"
      [ "$key" = APPLY_ARG ] && set -- "$@" "$value"
    done < "$file"
  else
    set -- "$@" /bin/true
  fi
  run_dockroot "$@" || return 1
  if [ "$stack_autostart" = 1 ]; then
    autostart_add "$name" >/dev/null
  else
    autostart_remove "$name" >/dev/null
  fi
  msg "配置已应用：$file"
}

container_pids() {
  name=$1
  run_dockroot ps "$name" 2>/dev/null | tr ' ' '\n' | sed -n '/^[0-9][0-9]*$/p'
}

container_rootfs_pids() {
  name=$1
  rootfs="${DATA_ROOT:-$STATE_DIR/data}/$name/rootfs"
  [ -d "$rootfs" ] || return 0
  for proc_root in "$PROC_ROOT"/[0-9]*/root; do
    [ -L "$proc_root" ] || continue
    [ "$(readlink "$proc_root" 2>/dev/null)" = "$rootfs" ] || continue
    pid=${proc_root#"$PROC_ROOT"/}
    pid=${pid%/root}
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    printf '%s\n' "$pid"
  done
}

container_all_pids() {
  name=$1
  {
    container_pids "$name"
    container_rootfs_pids "$name"
  } | sed -n '/^[0-9][0-9]*$/p' | sort -nu
}

container_is_running() {
  [ -n "$(container_pids "$1")" ]
}

port_listener() {
  port=$1
  ss -lntp 2>/dev/null | awk -v suffix=":$port" '$4 ~ suffix "$" { print; exit }'
}

port_is_listening() {
  [ -n "$(port_listener "$1")" ]
}

volume_is_mounted() {
  name=$1
  volume=$2
  source=${volume%%:*}
  remainder=${volume#*:}
  target=${remainder%%:*}
  # ruri 的部分 bind 挂载不一定出现在 /proc/<pid>/mountinfo（例如文件型挂载）；
  # 容器已运行且宿主机源路径存在时视为已挂载，避免健康检查误报。
  if [ -n "$(container_pids "$name")" ] && [ -e "$source" ]; then
    return 0
  fi
  for pid in $(container_pids "$name"); do
    [ -r "/proc/$pid/mountinfo" ] || continue
    if awk -v target="$target" '$5 == target { found=1 } END { exit !found }' "/proc/$pid/mountinfo"; then
      return 0
    fi
  done
  return 1
}

health_url_ok() {
  url=$1
  if have_cmd curl; then
    curl -fsS --max-time 3 "$url" >/dev/null 2>&1
  elif have_cmd wget; then
    wget -q -T 3 -O /dev/null "$url" >/dev/null 2>&1
  elif have_cmd busybox; then
    busybox wget -q -T 3 -O /dev/null "$url" >/dev/null 2>&1
  else
    return 1
  fi
}

rotate_log() {
  file=$1
  load_config
  [ -f "$file" ] || return 0
  size="$(wc -c < "$file" 2>/dev/null)"
  case "$size" in ''|*[!0-9]*) return 0 ;; esac
  limit=$((MAX_LOG_SIZE_KB * 1024))
  [ "$size" -le "$limit" ] && return 0
  rm -f "$file.1"
  mv -f "$file" "$file.1"
}

stop_stack() {
  name=${1:-}
  valid_name "$name" || { err '请提供有效配置名'; return 1; }
  require_runtime || return 1
  tracked_pids="$(container_pids "$name" | tr '\n' ' ')"
  rootfs_pids="$(container_rootfs_pids "$name" | tr '\n' ' ')"
  if [ -z "$tracked_pids" ] && [ -z "$rootfs_pids" ]; then
    return 0
  fi
  if [ -n "$tracked_pids" ]; then
    run_dockroot stop "$name" >/dev/null 2>&1 || true
  fi
  waited=0
  timeout=${STOP_TIMEOUT:-15}
  while container_is_running "$name" && [ "$waited" -lt "$timeout" ]; do
    sleep 1
    waited=$((waited + 1))
  done
  orphan_pids="$(container_rootfs_pids "$name" | tr '\n' ' ')"
  if [ -n "$orphan_pids" ]; then
    msg "正在清理未退出的容器进程：$name ($orphan_pids)"
    container_rootfs_pids "$name" | while IFS= read -r orphan_pid; do
      kill -TERM "$orphan_pid" 2>/dev/null || true
    done
    waited=0
    while [ -n "$(container_rootfs_pids "$name")" ] && [ "$waited" -lt 5 ]; do
      sleep 1
      waited=$((waited + 1))
    done
    orphan_pids="$(container_rootfs_pids "$name" | tr '\n' ' ')"
    if [ -n "$orphan_pids" ]; then
      container_rootfs_pids "$name" | while IFS= read -r orphan_pid; do
        kill -KILL "$orphan_pid" 2>/dev/null || true
      done
      sleep 1
    fi
  fi
  remaining_pids="$(container_all_pids "$name" | tr '\n' ' ')"
  if [ -n "$remaining_pids" ]; then
    err "容器停止超时，旧进程仍存在：$name ($(container_all_pids "$name" | tr '\n' ' '))"
    return 1
  fi
}

stack_lock_owner_active() {
  lock=$1
  [ -r "$lock/owner" ] || return 1
  read -r owner_pid owner_boot < "$lock/owner" || return 1
  case "$owner_pid" in ''|*[!0-9]*) return 1 ;; esac
  current_boot="$(cat "$PROC_ROOT/sys/kernel/random/boot_id" 2>/dev/null)"
  [ -n "$current_boot" ] && [ "$owner_boot" = "$current_boot" ] || return 1
  kill -0 "$owner_pid" 2>/dev/null || return 1
  cmdline="$(tr '\0' ' ' < "$PROC_ROOT/$owner_pid/cmdline" 2>/dev/null)"
  case "$cmdline" in *drctl*) return 0 ;; *) return 1 ;; esac
}

run_stack_locked() (
  operation=$1
  name=$2
  lock="$LOCK_DIR/$name.lock"
  ensure_state || exit 1
  if ! mkdir "$lock" 2>/dev/null; then
    if stack_lock_owner_active "$lock"; then
      err "容器正在执行其他操作：$name"
      exit 1
    fi
    rm -rf "$lock"
    mkdir "$lock" 2>/dev/null || { err "无法获取容器操作锁：$name"; exit 1; }
  fi
  boot_id="$(cat "$PROC_ROOT/sys/kernel/random/boot_id" 2>/dev/null)"
  printf '%s %s\n' "$$" "$boot_id" > "$lock/owner"
  trap 'rm -rf "$lock"' EXIT HUP INT TERM
  "$operation" "$name"
)

check_stack_ports_available() {
  name=$1
  for port in $(stack_values "$name" CHECK_PORT); do
    listener="$(port_listener "$port")"
    if [ -n "$listener" ]; then
      err "端口 $port 已被占用：$listener"
      return 1
    fi
  done
}

required_files_ready() {
  name=$1
  file="$(stack_file "$name")"
  [ -r "$file" ] || { err "配置不存在：$file"; return 1; }
  while IFS='=' read -r key value; do
    key="$(printf '%s' "$key" | tr -d '\r')"
    value="$(printf '%s' "$value" | tr -d '\r')"
    [ "$key" = REQUIRED_FILE ] || continue
    if [ ! -f "$value" ] || [ ! -s "$value" ]; then
      err "必需文件不存在或为空：$value"
      return 1
    fi
  done < "$file"
}

verify_stack_running() {
  name=$1
  waited=0
  timeout=${START_TIMEOUT:-30}
  while [ "$waited" -lt "$timeout" ]; do
    healthy=1
    container_is_running "$name" || healthy=0
    for volume in $(stack_values "$name" VOLUME); do
      volume_is_mounted "$name" "$volume" || healthy=0
    done
    for port in $(stack_values "$name" CHECK_PORT); do
      port_is_listening "$port" || healthy=0
    done
    for url in $(stack_values "$name" HEALTH_URL); do
      health_url_ok "$url" || healthy=0
    done
    [ "$healthy" = 1 ] && return 0
    sleep 1
    waited=$((waited + 1))
  done
  return 1
}

start_stack() {
  name=${1:-}
  valid_name "$name" || { err '请提供有效配置名'; return 1; }
  require_runtime || return 1
  required_files_ready "$name" || return 1
  stop_stack "$name" || return 1
  check_stack_ports_available "$name" || return 1
  rotate_log "$DATA_ROOT/$name/ruri.log"
  set -- run -d "$name"
  stack_command="$(stack_values "$name" COMMAND | head -n 1)"
  if [ -n "$stack_command" ]; then
    set -- "$@" -- "$stack_command"
    file="$(stack_file "$name")"
    while IFS='=' read -r key value; do
      key="$(printf '%s' "$key" | tr -d '\r')"
      value="$(printf '%s' "$value" | tr -d '\r')"
      [ "$key" = ARG ] && set -- "$@" "$value"
    done < "$file"
  fi
  if ! run_dockroot "$@"; then
    err "容器启动命令失败：$name"
    return 1
  fi
  if ! verify_stack_running "$name"; then
    err "容器未在规定时间内通过进程、挂载、端口或 HTTP 健康检查：$name"
    stop_stack "$name" >/dev/null 2>&1 || true
    return 1
  fi
  msg "容器已启动并通过健康检查：$name"
}

up_stack_unlocked() {
  name=${1:-}
  valid_name "$name" || { err '请提供有效配置名'; return 1; }
  required_files_ready "$name" || return 1
  stop_stack "$name" || return 1
  apply_stack "$name" || return 1
  start_stack "$name"
}

up_stack() {
  name=${1:-}
  valid_name "$name" || { err '请提供有效配置名'; return 1; }
  run_stack_locked up_stack_unlocked "$name"
}

rollback_updated_stack() {
  stack_name=$1
  current_path=$2
  backup_path=$3
  was_running=$4
  stop_stack "$stack_name" >/dev/null 2>&1 || true
  rm -rf "$current_path"
  if ! mv "$backup_path" "$current_path"; then
    err "新镜像启动失败，且旧版本目录恢复失败：$backup_path"
    return 1
  fi
  if ! apply_stack "$stack_name"; then
    err "旧版本目录已恢复，但配置重新应用失败：$stack_name"
    return 1
  fi
  if [ "$was_running" = 1 ] && ! start_stack "$stack_name"; then
    err "旧版本目录已恢复，但容器重新启动失败：$stack_name"
    return 1
  fi
  msg "新镜像验证失败，已自动回滚旧版本：$stack_name"
  return 1
}

update_stack_unlocked() {
  stack_name=${1:-}
  valid_name "$stack_name" || { err '请提供有效配置名'; return 1; }
  ensure_state || return 1
  load_config
  file="$(stack_file "$stack_name")"
  [ -r "$file" ] || { err "配置不存在：$file"; return 1; }
  image="$(stack_values "$stack_name" IMAGE | head -n 1)"
  [ -n "$image" ] || { err "配置缺少 IMAGE：$file"; return 1; }

  current_path="$DATA_ROOT/$stack_name"
  if [ ! -d "$current_path/rootfs" ]; then
    msg "容器尚未安装，将按当前配置首次部署：$stack_name"
    up_stack_unlocked "$stack_name"
    return
  fi

  temp_name="${stack_name}-update-$$"
  backup_name="${stack_name}-rollback-$$"
  temp_path="$DATA_ROOT/$temp_name"
  backup_path="$DATA_ROOT/$backup_name"
  rm -rf "$temp_path" "$backup_path"
  msg "正在后台下载新镜像，当前容器会继续运行：$stack_name"
  if ! pull_image "$image" "$temp_name" || [ ! -d "$temp_path/rootfs" ]; then
    rm -rf "$temp_path"
    err "新镜像下载或解包失败，旧容器未受影响：$stack_name"
    return 1
  fi

  was_running=0
  container_is_running "$stack_name" && was_running=1
  if ! stop_stack "$stack_name"; then
    rm -rf "$temp_path"
    return 1
  fi
  if ! mv "$current_path" "$backup_path"; then
    rm -rf "$temp_path"
    err "无法暂存旧版本目录：$current_path"
    return 1
  fi
  if ! mv "$temp_path" "$current_path"; then
    mv "$backup_path" "$current_path" 2>/dev/null || true
    if [ "$was_running" = 1 ]; then
      if apply_stack "$stack_name" >/dev/null 2>&1; then
        start_stack "$stack_name" >/dev/null 2>&1 || true
      fi
    fi
    err "无法替换新版本目录，已尝试恢复旧版本：$stack_name"
    return 1
  fi

  if ! apply_stack "$stack_name"; then
    rollback_updated_stack "$stack_name" "$current_path" "$backup_path" "$was_running"
    return 1
  fi
  if [ "$was_running" = 1 ] && ! start_stack "$stack_name"; then
    rollback_updated_stack "$stack_name" "$current_path" "$backup_path" "$was_running"
    return 1
  fi
  rm -rf "$backup_path"
  if [ "$was_running" = 1 ]; then
    msg "镜像已更新，容器已恢复运行：$stack_name"
  else
    msg "镜像已更新；容器更新前为停止状态，因此保持停止：$stack_name"
  fi
}

update_stack() {
  name=${1:-}
  valid_name "$name" || { err '请提供有效配置名'; return 1; }
  run_stack_locked update_stack_unlocked "$name"
}

down_stack() {
  name=${1:-}
  valid_name "$name" || { err '请提供有效配置名'; return 1; }
  run_stack_locked stop_stack "$name"
}

status_stack() {
  name=${1:-}
  valid_name "$name" || { err '请提供有效配置名'; return 1; }
  file="$(stack_file "$name")"
  [ -r "$file" ] || { err "配置不存在：$file"; return 1; }
  load_config
  migrate_stack "$name"
  pids="$(container_pids "$name" | tr '\n' ' ')"
  printf 'name=%s\n' "$name"
  printf 'config=%s\n' "$file"
  printf 'image=%s\n' "$(stack_values "$name" IMAGE | head -n 1)"
  printf 'autostart=%s\n' "$(stack_values "$name" AUTOSTART | head -n 1)"
  if [ -n "$pids" ]; then
    printf 'running=yes\n'
    printf 'pids=%s\n' "$pids"
  else
    printf 'running=no\n'
    return 1
  fi
  ok=1
  for volume in $(stack_values "$name" VOLUME); do
    target=${volume#*:}; target=${target%%:*}
    if volume_is_mounted "$name" "$volume"; then
      printf 'volume[%s]=mounted\n' "$target"
    else
      printf 'volume[%s]=missing\n' "$target"
      ok=0
    fi
  done
  while IFS='=' read -r key value; do
    key="$(printf '%s' "$key" | tr -d '\r')"
    value="$(printf '%s' "$value" | tr -d '\r')"
    [ "$key" = REQUIRED_FILE ] || continue
    if [ -f "$value" ] && [ -s "$value" ]; then
      printf 'required_file[%s]=ready\n' "$value"
    else
      printf 'required_file[%s]=missing\n' "$value"
      ok=0
    fi
  done < "$file"
  for port in $(stack_values "$name" CHECK_PORT); do
    if port_is_listening "$port"; then
      printf 'port[%s]=listening\n' "$port"
    else
      printf 'port[%s]=closed\n' "$port"
      ok=0
    fi
  done
  for url in $(stack_values "$name" HEALTH_URL); do
    if health_url_ok "$url"; then
      printf 'health[%s]=ok\n' "$url"
    else
      printf 'health[%s]=failed\n' "$url"
      ok=0
    fi
  done
  for url in $(stack_values "$name" READY_URL); do
    if health_url_ok "$url"; then
      printf 'ready[%s]=connected\n' "$url"
    else
      printf 'ready[%s]=disconnected\n' "$url"
      ok=0
    fi
  done
  [ "$ok" = 1 ]
}

stack_health_ok() {
  name=$1
  container_is_running "$name" || return 1
  required_files_ready "$name" >/dev/null 2>&1 || return 1
  for volume in $(stack_values "$name" VOLUME); do
    volume_is_mounted "$name" "$volume" || return 1
  done
  for port in $(stack_values "$name" CHECK_PORT); do
    port_is_listening "$port" || return 1
  done
  for url in $(stack_values "$name" HEALTH_URL); do
    health_url_ok "$url" || return 1
  done
  return 0
}

now_epoch() {
  date +%s 2>/dev/null || echo 0
}

healthcheck_stack() {
  name=$1
  valid_name "$name" || return 1
  file="$(stack_file "$name")"
  [ -r "$file" ] || return 1
  failures_file="$HEALTH_STATE_DIR/$name.failures"
  recovery_file="$HEALTH_STATE_DIR/$name.recovery"
  failures=0
  [ -r "$failures_file" ] && failures="$(cat "$failures_file" 2>/dev/null)"
  case "$failures" in ''|*[!0-9]*) failures=0 ;; esac

  if stack_health_ok "$name"; then
    [ "$failures" = 0 ] || printf '0\n' > "$failures_file"
    return 0
  fi

  failures=$((failures + 1))
  printf '%s\n' "$failures" > "$failures_file"
  msg "健康检查失败（$failures/$HEALTHCHECK_FAILURES）：$name"
  [ "$failures" -ge "$HEALTHCHECK_FAILURES" ] || return 1

  now="$(now_epoch)"
  last=0
  [ -r "$recovery_file" ] && last="$(cat "$recovery_file" 2>/dev/null)"
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  if [ "$now" -gt 0 ] && [ "$last" -gt 0 ] && [ $((now - last)) -lt "$HEALTHCHECK_COOLDOWN" ]; then
    msg "仍在自愈冷却期，暂不重启：$name"
    return 1
  fi

  printf '%s\n' "$now" > "$recovery_file"
  msg "连续健康检查失败，正在自动恢复：$name"
  if up_stack "$name"; then
    printf '0\n' > "$failures_file"
    msg "自动恢复成功：$name"
    return 0
  fi
  msg "自动恢复失败：$name"
  return 1
}

healthcheck_once() {
  ensure_state || return 1
  load_config
  [ "$HEALTHCHECK_ENABLE" = 1 ] || return 0
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    valid_name "$name" || continue
    healthcheck_stack "$name" || true
  done < "$AUTOSTART_FILE"
}

watchdog() {
  ensure_state || return 1
  while true; do
    load_config
    case "$HEALTHCHECK_INTERVAL" in 0) HEALTHCHECK_INTERVAL=300 ;; esac
    if [ "$SCHEDULED_WAKE" = 1 ]; then
      start_scheduled_wake >> "$LOG_DIR/wakealarm.log" 2>&1 || true
    elif scheduled_wake_is_active; then
      stop_scheduled_wake
    fi
    if [ "$HEALTHCHECK_ENABLE" = 1 ]; then
      healthcheck_once >> "$LOG_DIR/healthcheck.log" 2>&1
      rotate_log "$LOG_DIR/healthcheck.log"
    fi
    sleep "$HEALTHCHECK_INTERVAL"
  done
}

service_main() {
  ensure_state || return 1
  load_config
  if [ "$KEEP_AWAKE" = 1 ]; then
    stop_scheduled_wake
    acquire_wakelock || msg '警告：无法获取 CPU 唤醒锁'
  elif [ "$SCHEDULED_WAKE" = 1 ]; then
    release_wakelock
    start_scheduled_wake || msg '警告：定时短唤醒服务启动失败'
  else
    stop_scheduled_wake
    release_wakelock
  fi
  trap 'stop_scheduled_wake; release_wakelock' EXIT HUP INT TERM
  boot
  watchdog
}

scheduled_wake_pid() {
  [ -r "$WAKEALARM_PID_FILE" ] || return 1
  pid="$(cat "$WAKEALARM_PID_FILE" 2>/dev/null)"
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  cmdline="$(tr '\0' ' ' < "$PROC_ROOT/$pid/cmdline" 2>/dev/null)"
  case "$cmdline" in *wakealarm*"$WAKEALARM_STATUS_FILE"*) printf '%s\n' "$pid" ;; *) return 1 ;; esac
}

scheduled_wake_is_active() {
  scheduled_wake_pid >/dev/null 2>&1
}

scheduled_wakelock_is_active() {
  [ -r "$POWER_ROOT/wake_lock" ] || return 1
  grep -F "$SCHEDULED_WAKELOCK_TAG" "$POWER_ROOT/wake_lock" >/dev/null 2>&1
}

release_scheduled_wakelock() {
  [ -w "$POWER_ROOT/wake_unlock" ] || return 0
  printf '%s\n' "$SCHEDULED_WAKELOCK_TAG" > "$POWER_ROOT/wake_unlock" 2>/dev/null || true
}

stop_scheduled_wake() {
  pid="$(scheduled_wake_pid 2>/dev/null)" || pid=''
  if [ -n "$pid" ]; then
    kill -TERM "$pid" 2>/dev/null || true
    waited=0
    while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 5 ]; do
      sleep 1
      waited=$((waited + 1))
    done
    kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$WAKEALARM_PID_FILE" "$WAKEALARM_STATUS_FILE"
  release_scheduled_wakelock
}

start_scheduled_wake() {
  scheduled_wake_is_active && return 0
  binary="$MODDIR/bin/wakealarm"
  [ -x "$binary" ] || { err "缺少定时唤醒助手：$binary"; return 1; }
  rm -f "$WAKEALARM_PID_FILE" "$WAKEALARM_STATUS_FILE"
  nohup "$binary" \
    -times "$WAKE_TIMES" \
    -timezone "$WAKE_TIMEZONE" \
    -hold "$WAKE_HOLD_SECONDS" \
    -tag "$SCHEDULED_WAKELOCK_TAG" \
    -wake-lock "$POWER_ROOT/wake_lock" \
    -wake-unlock "$POWER_ROOT/wake_unlock" \
    -status-file "$WAKEALARM_STATUS_FILE" \
    -log-file "$LOG_DIR/wakealarm.log" \
    >/dev/null 2>&1 </dev/null &
  pid=$!
  printf '%s\n' "$pid" > "$WAKEALARM_PID_FILE"
  sleep 1
  if ! scheduled_wake_is_active; then
    rm -f "$WAKEALARM_PID_FILE"
    err "定时唤醒助手启动失败，请查看 $LOG_DIR/wakealarm.log"
    return 1
  fi
}

acquire_wakelock() {
  [ -w "$POWER_ROOT/wake_lock" ] || return 1
  # 部分 Android 内核会先成功持锁，再向写入方返回 EINVAL。
  # 此时以 sysfs 中的实际锁状态为准，避免误报失败且漏存配置。
  printf '%s\n' "$WAKELOCK_TAG" > "$POWER_ROOT/wake_lock" 2>/dev/null || wakelock_is_active
}

release_wakelock() {
  [ -w "$POWER_ROOT/wake_unlock" ] || return 0
  printf '%s\n' "$WAKELOCK_TAG" > "$POWER_ROOT/wake_unlock" 2>/dev/null || true
}

wakelock_is_active() {
  [ -r "$POWER_ROOT/wake_lock" ] || return 1
  grep -F "$WAKELOCK_TAG" "$POWER_ROOT/wake_lock" >/dev/null 2>&1
}

save_config_value() {
  key=$1
  value=$2
  ensure_state || return 1
  temp="$CONFIG_FILE.tmp.$$"
  awk -F= -v key="$key" -v value="$value" '
    BEGIN { found=0 }
    $1 == key { print key "=" value; found=1; next }
    { print }
    END { if (!found) print key "=" value }
  ' "$CONFIG_FILE" > "$temp" || { rm -f "$temp"; return 1; }
  chmod 0600 "$temp" && mv -f "$temp" "$CONFIG_FILE"
}

save_wake_mode() {
  continuous=$1
  scheduled=$2
  save_config_value KEEP_AWAKE "$continuous" || return 1
  save_config_value SCHEDULED_WAKE "$scheduled"
}

wakelock_command() {
  action=${1:-status}
  case "$action" in
    on)
      stop_scheduled_wake
      acquire_wakelock || { err '设备不支持 /sys/power/wake_lock 或权限不足'; return 1; }
      save_wake_mode 1 0 || { release_wakelock; return 1; }
      msg 'CPU 持续唤醒已启用，定时任务更准时，但会增加待机耗电'
      ;;
    scheduled)
      [ -x "$MODDIR/bin/wakealarm" ] || { err '当前模块未包含定时唤醒助手，请先更新模块'; return 1; }
      stop_scheduled_wake
      release_wakelock
      save_wake_mode 0 1 || return 1
      load_config
      start_scheduled_wake || return 1
      msg "定时短唤醒已启用：$WAKE_TIMES，每次保持 ${WAKE_HOLD_SECONDS} 秒"
      ;;
    off)
      stop_scheduled_wake
      release_wakelock
      save_wake_mode 0 0 || return 1
      msg 'CPU 唤醒已停用'
      ;;
    status)
      load_config
      printf 'configured=%s\n' "$KEEP_AWAKE"
      printf 'active=%s\n' "$(wakelock_is_active && echo yes || echo no)"
      if [ "$KEEP_AWAKE" = 1 ]; then
        printf 'mode=continuous\n'
      elif [ "$SCHEDULED_WAKE" = 1 ]; then
        printf 'mode=scheduled\n'
      else
        printf 'mode=off\n'
      fi
      printf 'scheduler=%s\n' "$(scheduled_wake_is_active && echo yes || echo no)"
      printf 'scheduled_lock=%s\n' "$(scheduled_wakelock_is_active && echo yes || echo no)"
      [ -r "$WAKEALARM_STATUS_FILE" ] && cat "$WAKEALARM_STATUS_FILE"
      ;;
    *) err '用法：wakelock on|scheduled|off|status'; return 1 ;;
  esac
}

stack_public_url() {
  name=$1
  url="$(stack_values "$name" HEALTH_URL | head -n 1)"
  [ -n "$url" ] || return 0
  printf '%s\n' "$url" | sed 's#^\(http://[^/]*\).*#\1#'
}

device_lan_ipv4() {
  ip -o -4 addr show 2>/dev/null | awk '
    function is_private(ip, octets) {
      split(ip, octets, ".")
      return octets[1] == 10 ||
        (octets[1] == 172 && octets[2] >= 16 && octets[2] <= 31) ||
        (octets[1] == 192 && octets[2] == 168)
    }
    {
      interface = $2
      sub(/@.*/, "", interface)
      address = $4
      sub(/\/.*/, "", address)
      if (interface ~ /^(wlan|ap|swlan|softap|eth|en|rndis|usb|br|lan)/ && is_private(address)) {
        print address
        exit
      }
    }
  '
}

stack_lan_url() {
  url=$1
  lan_ip=$2
  [ -n "$url" ] && [ -n "$lan_ip" ] || return 0
  scheme=${url%%://*}
  [ "$scheme" = http ] || [ "$scheme" = https ] || return 0
  host_port=${url#*://}
  case "$host_port" in
    *:*) port=${host_port##*:}; printf '%s://%s:%s\n' "$scheme" "$lan_ip" "$port" ;;
    *) printf '%s://%s\n' "$scheme" "$lan_ip" ;;
  esac
}

web_status() {
  ensure_state || return 1
  load_config
  lan_ip="$(device_lan_ipv4 | head -n 1)"
  for file in "$STACK_DIR"/*.conf; do
    [ -f "$file" ] || continue
    name="$(basename "$file" .conf)"
    if stack_health_ok "$name"; then
      state=healthy
    elif container_is_running "$name"; then
      state=unhealthy
    else
      state=stopped
    fi
    public_url="$(stack_public_url "$name")"
    lan_url="$(stack_lan_url "$public_url" "$lan_ip")"
    autostart="$(stack_values "$name" AUTOSTART | head -n 1)"
    [ "$autostart" = 1 ] || autostart=0
    printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$state" "$public_url" "$lan_url" "$autostart"
  done
}

init_stack() {
  [ "$#" -eq 2 ] || { err '用法：stack init <配置名> <镜像>'; return 1; }
  name=${1:-}
  image=${2:-}
  valid_name "$name" || { err '请提供有效配置名'; return 1; }
  case "$image" in
    ''|*[[:space:]]*) err '请提供不含空白字符的镜像名称'; return 1 ;;
  esac
  ensure_state || return 1
  target="$(stack_file "$name")"
  [ ! -e "$target" ] || { err "配置已存在，不会覆盖：$target"; return 1; }
  temp="$target.tmp.$$"
  {
    printf '# 通用 Compose Lite 配置；按需取消注释并修改可选字段\n'
    printf 'IMAGE=%s\n' "$image"
    printf 'AUTOSTART=0\n'
    printf 'HOSTNAME=%s\n' "$name"
    printf '\n'
    printf '# VOLUME=%s/%s:/容器内路径\n' "$VOLUME_DIR" "$name"
    printf '# ENV=KEY=VALUE\n'
    printf '# COMMAND=/容器内启动程序\n'
    printf '# ARG=单个启动参数\n'
    printf '# CHECK_PORT=端口\n'
    printf '# HEALTH_URL=http://127.0.0.1:端口/health\n'
  } > "$temp" || { rm -f "$temp"; return 1; }
  if ! chmod 0600 "$temp" || ! mv -f "$temp" "$target"; then
    rm -f "$temp"
    return 1
  fi
  msg "已创建通用配置：$target"
  msg "请编辑配置后执行：$0 up $name"
}

list_examples() {
  found=0
  for file in "$MODDIR"/examples/*.conf; do
    [ -f "$file" ] || continue
    basename "$file" .conf
    found=1
  done
  [ "$found" = 1 ] || msg '当前模块没有附带示例'
}

copy_stack_example() {
  case "$#" in
    1|2) ;;
    *) err '用法：stack example <示例> [配置名]'; return 1 ;;
  esac
  example=${1:-}
  name=${2:-$example}
  valid_name "$example" || { err '请提供有效示例名'; return 1; }
  valid_name "$name" || { err '请提供有效配置名'; return 1; }
  ensure_state || return 1
  source="$MODDIR/examples/$example.conf"
  [ -r "$source" ] || {
    err "示例不存在：$example"
    printf '可用示例：\n' >&2
    list_examples >&2
    return 1
  }
  target="$(stack_file "$name")"
  [ ! -e "$target" ] || { err "配置已存在，不会覆盖：$target"; return 1; }
  temp="$target.tmp.$$"
  sed "s|__STACK_NAME__|$name|g" "$source" > "$temp" || {
    rm -f "$temp"
    return 1
  }
  if ! chmod 0600 "$temp" || ! mv -f "$temp" "$target"; then
    rm -f "$temp"
    return 1
  fi
  msg "已从示例 $example 创建配置：$target"
  msg "如需修改端口或目录，请先编辑该配置，再执行：$0 up $name"
}

# 兼容旧命令；实现仍然是通用示例复制，不再按容器名进入核心分支。
create_stack() {
  example=${1:-}
  [ "$#" -le 1 ] || {
    err 'stack create 不再接收端口参数；请创建后直接编辑 .conf'
    return 1
  }
  copy_stack_example "$example" "$example"
}

remove_stack() {
  [ "$#" -eq 1 ] || { err '用法：stack remove <配置名>'; return 1; }
  name=${1:-}
  valid_name "$name" || { err '请提供有效配置名'; return 1; }
  ensure_state || return 1
  file="$(stack_file "$name")"
  [ -f "$file" ] || { err "配置不存在：$file"; return 1; }
  if runtime_ready && [ -n "$(container_pids "$name")" ]; then
    err "容器仍在运行，请先执行：$0 down $name"
    return 1
  fi
  autostart_remove "$name"
  rm -f "$file" || return 1
  msg "已删除配置：$file"
  msg "镜像 rootfs 与业务卷未删除，需要时仍可重新创建配置"
}

set_stack_secret() {
  name=${1:-}
  valid_name "$name" || { err '请提供有效配置名'; return 1; }
  ensure_state || return 1
  file="$(stack_file "$name")"
  [ -r "$file" ] || { err "配置不存在：$file"; return 1; }
  secret_file="$(stack_values "$name" REQUIRED_FILE | head -n 1)"
  [ -n "$secret_file" ] || { err "配置没有 REQUIRED_FILE：$file"; return 1; }
  case "/$secret_file/" in
    */../*|*/./*) err '秘密文件路径不能包含 . 或 .. 路径段'; return 1 ;;
  esac
  case "$secret_file" in
    "$VOLUME_DIR/$name/"*) ;;
    *) err "出于安全考虑，只允许写入 $VOLUME_DIR/$name 内的秘密文件"; return 1 ;;
  esac

  secret_dir=${secret_file%/*}
  mkdir -p "$secret_dir" || return 1
  secret=
  secret_tty=0
  if [ -t 0 ] && have_cmd stty; then
    printf '请输入秘密内容（输入不会显示），然后按回车：' >&2
    stty -echo
    secret_tty=1
    trap 'stty echo 2>/dev/null; printf "\n" >&2; exit 130' HUP INT TERM
  else
    printf '请通过标准输入提供秘密内容：' >&2
  fi
  IFS= read -r secret
  read_status=$?
  if [ "$secret_tty" = 1 ]; then
    stty echo 2>/dev/null || true
    printf '\n' >&2
    trap - HUP INT TERM
  fi
  [ "$read_status" = 0 ] || { err '未能读取秘密内容'; return 1; }
  secret="$(printf '%s' "$secret" | tr -d '\r')"
  case "$secret" in
    ''|*[[:space:]]*) err '秘密内容不能为空或包含空白字符'; unset secret; return 1 ;;
  esac

  temp="$secret_file.tmp.$$"
  umask 077
  if ! printf '%s\n' "$secret" > "$temp"; then
    unset secret
    rm -f "$temp"
    return 1
  fi
  unset secret
  # /data/adb/dockroot 上级目录仅 root 可进入；文件需允许镜像内的 nonroot 用户读取。
  if ! chmod 0644 "$temp" || ! mv -f "$temp" "$secret_file"; then
    rm -f "$temp"
    err "秘密文件写入失败：$secret_file"
    return 1
  fi
  msg "秘密已保存：$secret_file"
  msg "执行 $0 up $name 使其生效"
}

list_stacks() {
  ensure_state || return 1
  found=0
  for file in "$STACK_DIR"/*.conf; do
    [ -f "$file" ] || continue
    basename "$file" .conf
    found=1
  done
  [ "$found" = 1 ] || msg "暂无配置，目录：$STACK_DIR"
}

cleanup_state() {
  mode=${1:-preview}
  sync_dockroot_config || return 1
  [ -f "$DATA_ROOT/.dockroot-managed" ] || {
    err "拒绝清理未受管目录：$DATA_ROOT"
    return 1
  }
  found=0
  for path in "$DATA_ROOT"/*; do
    [ -d "$path" ] || continue
    [ ! -d "$path/rootfs" ] || continue
    found=1
    if [ "$mode" = --yes ]; then
      rm -rf "$path"
      msg "已删除不完整目录：$path"
    else
      msg "可清理不完整目录：$path"
    fi
  done
  for path in "$RUNTIME_DIR"/*.download.*; do
    [ -f "$path" ] || continue
    found=1
    if [ "$mode" = --yes ]; then
      rm -f "$path"
      msg "已删除下载残片：$path"
    else
      msg "可清理下载残片：$path"
    fi
  done
  if [ "$found" = 0 ]; then
    msg '没有发现可安全清理的旧文件'
  elif [ "$mode" != --yes ]; then
    msg "以上仅为预览；确认后执行：$0 cleanup --yes"
  fi
}

pull_image() {
  image=${1:-}
  name=${2:-}
  [ -n "$image" ] || { err '请提供镜像名称'; return 1; }
  valid_name "$name" || { err '请提供有效容器名'; return 1; }
  require_runtime || return 1
  normalized="$(normalize_image "$image")"
  case "$normalized" in
    *@*) err 'DockRoot 当前不支持按摘要准确拉取镜像'; return 1 ;;
    *:latest) ;;
    *)
      err "DockRoot 上游当前会丢失非 latest 标签，已拒绝可能拉错的镜像：$normalized"
      return 1
      ;;
  esac
  cleanup_incomplete_destination "$name"
  msg "正在从 $normalized 拉取镜像"
  run_dockroot pull "$normalized" "$name"
}

autostart_add() {
  name=${1:-}
  valid_name "$name" || { err '容器名只能包含字母、数字、点、下划线和短横线'; return 1; }
  ensure_state || return 1
  grep -Fx "$name" "$AUTOSTART_FILE" >/dev/null 2>&1 || printf '%s\n' "$name" >> "$AUTOSTART_FILE"
  msg "已加入开机自启：$name"
}

autostart_remove() {
  name=${1:-}
  valid_name "$name" || { err '容器名无效'; return 1; }
  temp="$AUTOSTART_FILE.tmp.$$"
  grep -Fvx "$name" "$AUTOSTART_FILE" > "$temp" 2>/dev/null || true
  mv -f "$temp" "$AUTOSTART_FILE"
  chmod 0600 "$AUTOSTART_FILE"
  msg "已移除开机自启：$name"
}

autostart_list() {
  ensure_state || return 1
  sed '/^[[:space:]]*$/d' "$AUTOSTART_FILE"
}

set_stack_autostart() {
  name=${1:-}
  mode=${2:-}
  valid_name "$name" || { err '请提供有效配置名'; return 1; }
  case "$mode" in
    1|on|enable|enabled) enabled=1 ;;
    0|off|disable|disabled) enabled=0 ;;
    *) err '用法：autostart set <配置名> on|off'; return 1 ;;
  esac
  ensure_state || return 1
  file="$(stack_file "$name")"
  [ -r "$file" ] || { err "配置不存在：$file"; return 1; }
  temp="$file.tmp.$$"
  awk -F= -v enabled="$enabled" '
    BEGIN { found=0 }
    $1 == "AUTOSTART" { print "AUTOSTART=" enabled; found=1; next }
    { print }
    END { if (!found) print "AUTOSTART=" enabled }
  ' "$file" > "$temp" || { rm -f "$temp"; return 1; }
  if ! chmod 0600 "$temp" || ! mv -f "$temp" "$file"; then
    rm -f "$temp"
    return 1
  fi
  if [ "$enabled" = 1 ]; then
    autostart_add "$name" >/dev/null || return 1
    msg "已开启开机自启：$name（当前容器状态不变）"
  else
    autostart_remove "$name" >/dev/null || return 1
    msg "已关闭开机自启：$name（当前容器仍会继续运行）"
  fi
}

boot() {
  ensure_state || exit 1
  load_config
  [ "$AUTO_START" = 1 ] || exit 0
  waited=0
  while [ "$(getprop sys.boot_completed 2>/dev/null)" != 1 ] && [ "$waited" -lt "$BOOT_WAIT" ]; do
    sleep 2
    waited=$((waited + 2))
  done
  require_runtime || exit 0
  rotate_log "$LOG_DIR/service.log"
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    valid_name "$name" || continue
    msg "正在自启容器：$name" >> "$LOG_DIR/service.log"
    up_stack "$name" >> "$LOG_DIR/service.log" 2>&1 || \
      msg "容器自启失败：$name" >> "$LOG_DIR/service.log"
  done < "$AUTOSTART_FILE"
}

doctor() {
  ensure_state || return 1
  load_config
  printf 'architecture=%s\n' "$(uname -m 2>/dev/null)"
  printf 'selinux=%s\n' "$(getenforce 2>/dev/null || echo unknown)"
  printf 'runtime=%s\n' "$(runtime_ready && echo installed || echo missing)"
  printf 'data_root=%s\n' "$DATA_ROOT"
  if [ -e "$DATA_ROOT" ]; then
    filesystem="$(awk -v path="$DATA_ROOT" '
      $2 == "/" || index(path, $2 "/") == 1 {
        if (length($2) > best) { best = length($2); type = $3 }
      }
      END { print type }
    ' /proc/mounts 2>/dev/null)"
    printf 'filesystem=%s\n' "${filesystem:-unknown}"
  else
    printf 'filesystem=missing\n'
  fi
  printf 'autostart=%s\n' "$AUTO_START"
  printf 'boot_completed=%s\n' "$(getprop sys.boot_completed 2>/dev/null)"
  [ -x /system/bin/unshare ] && echo 'mount_namespace=yes' || echo 'mount_namespace=no'
  [ -e /proc ] && echo 'proc=yes' || echo 'proc=no'
  [ -e /sys ] && echo 'sys=yes' || echo 'sys=no'
  [ -e /dev ] && echo 'dev=yes' || echo 'dev=no'
}

usage() {
  cat <<'EOF'
DockRoot 容器模块（实验性）

用法：drctl <命令> [参数]

  install-runtime                 下载并校验 DockRoot/ruri
  doctor                          输出兼容性诊断
  healthcheck                     立即检查自启容器并按阈值自愈
  wakelock on|scheduled|off|status 控制全天或定时短唤醒
  pull <镜像:标签> <容器名>       拉取镜像
  run [-d] <容器名> [命令...]     运行或进入容器
  stop <容器名>                   停止容器
  ps [容器名]                     查看运行状态
  logs <容器名> [行数]            查看容器日志
  autostart add <容器名>           加入开机自启
  autostart remove <容器名>        移除开机自启
  autostart set <配置名> on|off    持久修改 Stack 的开机自启
  autostart list                  查看开机自启列表
  stack init <配置名> <镜像>            创建与具体应用无关的通用配置
  stack examples                       列出模块附带的示例配置
  stack example <示例> [配置名]        复制示例，可使用不同配置名
  stack create <示例>                  兼容旧版的示例复制命令
  stack secret <配置名>                隐藏输入并保存模板所需的秘密文件
  stack remove <配置名>                删除配置，保留镜像与业务卷
  stack list                      查看声明式配置
  apply <配置名>                  应用固定配置但不启动
  up <配置名>                     应用配置并后台启动
  down <配置名>                   停止配置对应的容器
  restart <配置名>                重新应用配置并启动
  update <配置名>                 下载最新镜像，验证失败时自动回滚
  status <配置名>                 查看进程、卷、端口和 HTTP 健康状态
  cleanup [--yes]                 预览/清理失败拉取残留

注意：DockRoot 只支持 host 网络，不支持 -p 端口映射。
EOF
}

main() {
  command=${1:-help}
  [ $# -eq 0 ] || shift
  case "$command" in
    help|-h|--help) usage ;;
    install-runtime) install_runtime ;;
    doctor) doctor ;;
    boot) boot ;;
    service) service_main ;;
    watchdog) watchdog ;;
    healthcheck) healthcheck_once ;;
    wakelock) wakelock_command "${1:-status}" ;;
    web-status) web_status ;;
    apply) apply_stack "${1:-}" ;;
    up) up_stack "${1:-}" ;;
    down) down_stack "${1:-}" ;;
    restart) up_stack "${1:-}" ;;
    update) update_stack "${1:-}" ;;
    status) status_stack "${1:-}" ;;
    cleanup) cleanup_state "${1:-preview}" ;;
    stack)
      sub=${1:-list}
      [ $# -eq 0 ] || shift
      case "$sub" in
        init) init_stack "$@" ;;
        examples)
          [ "$#" -eq 0 ] || { err '用法：stack examples'; return 1; }
          list_examples
          ;;
        example) copy_stack_example "$@" ;;
        create) create_stack "$@" ;;
        secret) set_stack_secret "${1:-}" ;;
        remove|rm) remove_stack "$@" ;;
        list) list_stacks ;;
        path) ensure_state; printf '%s\n' "$STACK_DIR" ;;
        *) err '可用子命令：init、examples、example、create、secret、remove、list、path'; return 1 ;;
      esac
      ;;
    pull) pull_image "$@" ;;
    run|stop|ps|rm|inspect|layers|tags)
      require_runtime || return 1
      run_dockroot "$command" "$@"
      ;;
    logs)
      name=${1:-}
      lines=${2:-100}
      valid_name "$name" || { err '请提供有效容器名'; return 1; }
      case "$lines" in ''|*[!0-9]*) err '日志行数必须是数字'; return 1;; esac
      load_config
      tail -n "$lines" "$DATA_ROOT/$name/ruri.log"
      ;;
    autostart)
      sub=${1:-list}
      [ $# -eq 0 ] || shift
      case "$sub" in
        add) autostart_add "${1:-}" ;;
        remove|rm) autostart_remove "${1:-}" ;;
        set) set_stack_autostart "${1:-}" "${2:-}" ;;
        list) autostart_list ;;
        *) err '可用子命令：add、remove、set、list'; return 1 ;;
      esac
      ;;
    *) err "未知命令：$command"; usage >&2; return 1 ;;
  esac
}

if [ "${DRCTL_SOURCE_ONLY:-0}" != 1 ]; then
  main "$@"
fi
