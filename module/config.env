# 是否在开机后启动 autostart.list 中的容器：1=启用，0=停用
AUTO_START=1

# 等待 Android 完成开机的最长秒数
BOOT_WAIT=120

# DockRoot 数据目录。不要放在 /sdcard 等共享存储中
DATA_ROOT=/data/adb/dockroot/data

# 仅供 DockRoot 独立网络环境使用，不修改 Android 系统 DNS
DNS_SERVERS=223.5.5.5 1.1.1.1

# 停止旧进程和等待新容器健康的超时时间（秒）
STOP_TIMEOUT=15
START_TIMEOUT=30

# 模块与容器启动日志超过该大小后轮转，单位 KiB
MAX_LOG_SIZE_KB=1024

# 容器健康保活：只监控 AUTOSTART=1 的 Stack
HEALTHCHECK_ENABLE=1
HEALTHCHECK_INTERVAL=300
HEALTHCHECK_FAILURES=3
HEALTHCHECK_COOLDOWN=1800

# 持续防止 CPU 深度休眠：1=启用，0=停用。会增加待机耗电
KEEP_AWAKE=0

# 定时短唤醒：1=启用，0=停用。与 KEEP_AWAKE=1 互斥
SCHEDULED_WAKE=0

# 每天提前唤醒的本地时间，逗号分隔；默认覆盖 09:58、17:58 抢兑任务
WAKE_TIMES=09:57,17:57

# 每次唤醒后保持 CPU 运行的秒数
WAKE_HOLD_SECONDS=300

# 定时唤醒使用的 IANA 时区
WAKE_TIMEZONE=Asia/Shanghai
